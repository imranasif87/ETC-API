{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Display configuration for js/renderer.js",
  "description": "Rules for config files. See docs/config-guide.md. Unknown keys are errors, so misspelt keys are caught.",
  "type": "object",
  "required": [
    "appliesTo",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "configVersion": {
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "appliesTo": {
      "type": "string",
      "pattern": "^\\S+:\\S+$"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "termLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "unmapped": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "hide": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/section"
      }
    }
  },
  "definitions": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "title",
            "row",
            "rows",
            "cards"
          ]
        },
        "label": {
          "type": "string"
        },
        "labelFrom": {
          "$ref": "#/definitions/path"
        },
        "heading": {
          "type": "string"
        },
        "headingFrom": {
          "$ref": "#/definitions/path"
        },
        "itemsFrom": {
          "$ref": "#/definitions/path"
        },
        "valueFrom": {
          "anyOf": [
            {
              "$ref": "#/definitions/path"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/path"
              }
            }
          ]
        },
        "display": {
          "enum": [
            "text",
            "link",
            "html"
          ]
        },
        "linkFrom": {
          "$ref": "#/definitions/path"
        },
        "suffixFrom": {
          "$ref": "#/definitions/path"
        },
        "titleFrom": {
          "$ref": "#/definitions/path"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unlisted": {
          "enum": [
            "append",
            "hide"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rows"
              }
            }
          },
          "then": {
            "required": [
              "itemsFrom"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cards"
              }
            }
          },
          "then": {
            "required": [
              "itemsFrom"
            ]
          }
        }
      ]
    }
  }
}