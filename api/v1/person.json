{
    "@context": {
        "@version": 1.1,
        "@protected": true,
        "@vocab": "https://etc.web.ox.ac.uk/api/v1#",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "dcterms": "http://purl.org/dc/terms/",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "suppa": "https://etc.web.ox.ac.uk/api/v1#",
        "etcrel": "https://etc.web.ox.ac.uk/vocabulary/relationship/#",
        "prov": "http://www.w3.org/ns/prov#",
        "type": "@type",
        "id": "@id",
        "created": {
            "@id": "dcterms:created",
            "@type": "xsd:dateTime"
        },
        "updated": {
            "@id": "dcterms:modified",
            "@type": "xsd:dateTime"
        },
        "etcIdentifier": {
            "@id": "suppa:etcIdentifier"
        },
        "derivedFrom": {
            "@id": "prov:wasDerivedFrom",
            "@type": "@id"
        },
        "relatedTo": {
            "@id": "dcterms:relation",
            "@type": "@id"
        },
        "date": {
            "@id": "dcterms:date"
        },
        "citation": {
            "@id": "dcterms:bibliographicCitation"
        },
        "place": {
            "@id": "suppa:place",
            "@type": "@id"
        },
        "format": {
            "@id": "suppa:format",
            "@type": "@vocab"
        },
        "activities": {
            "@id": "suppa:activities",
            "@container": "@set"
        },
        "role": {
            "@id": "suppa:hasRelationRole",
            "@type": "@vocab"
        },
        "activityByPlace": {
            "@id": "suppa:activityByPlace",
            "@type": "@id",
            "@context": {
                "items": {
                    "@id": "suppa:hasPlaceActivity",
                    "@container": "@set"
                }
            }
        },
        "biography": {
            "@id": "suppa:biography"
        },
        "biographyNote": {
            "@id": "suppa:biographyNote"
        },
        "relatedWorks": {
            "@id": "suppa:relatedWorks",
            "@type": "@id",
            "@context": {
                "items": {
                    "@id": "suppa:hasRelatedWork",
                    "@container": "@set"
                }
            }
        },
        "events": {
            "@id": "suppa:events",
            "@type": "@id",
            "@context": {
                "items": {
                    "@id": "suppa:hasEvent",
                    "@container": "@set"
                }
            }
        },
        "documents": {
            "@id": "suppa:documents",
            "@type": "@id",
            "@context": {
                "items": {
                    "@id": "suppa:hasDocument",
                    "@container": "@set"
                }
            }
        },
        "literature": {
            "@id": "suppa:literature",
            "@type": "@id",
            "@context": {
                "items": {
                    "@id": "suppa:hasLiteratureReference",
                    "@container": "@set"
                }
            }
        },
        "personNotes": {
            "@id": "suppa:personNotes"
        }
    }
}